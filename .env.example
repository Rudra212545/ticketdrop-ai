# ============================================
# TicketDrop AI — Local Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git!
# ============================================

# --- PostgreSQL (Neon Cloud OR Local Docker) ---
# Neon format: jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/ticketdrop
DB_USERNAME=ticketdrop
DB_PASSWORD=ticketdrop_dev

# --- Redis (Redis Cloud OR Local Docker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# --- JWT Security (Use any random 64+ char secret in dev) ---
JWT_SECRET=change-me-to-a-very-long-random-256-bit-secret-key-for-ticketdrop-ai-2026
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Kafka (Phase 3 — Aiven/Confluent Cloud OR Local Docker) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Google Gemini API (Phase 4 — Google AI Studio Key) ---
GEMINI_API_KEY=your-google-ai-studio-api-key

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

